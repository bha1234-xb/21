<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Quản lý tài sản</title>

    <link rel="stylesheet"
          href="~/css/BHA_Layout.css" />
</head>

<body>


    @await Html.PartialAsync("BHA_Header")

    <main>
        @RenderBody()
    </main>
    @await Html.PartialAsync("BHA_Footer")

    <div class="to-top">&uarr;</div>
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>